# ---- Backend ----
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/hrms?sslmode=require
PORT=5000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000
SUPER_ADMIN_EMAIL=admin@zalgoinfotech.com
SUPER_ADMIN_PASSWORD=Admin@12345
HARDWARE_AGENT_KEY=change-me-agent-key
# Optional — AI HR assistant (Phase 9). https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Self-service signup + Razorpay (see README "Self-service signup & Razorpay")
APP_URL=http://localhost:3000
SIGNUP_ENABLED=true
SIGNUP_TRIAL_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:5000/api/v1

# ---- Hardware Agent ----
AGENT_PORT=5001
BACKEND_URL=http://localhost:5000
